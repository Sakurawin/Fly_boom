<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/ui2_rank_row_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/rank_index"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ui2_muted"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/rank_avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/ui2_avatar_border"
        android:padding="2dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/rank_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/ui2_title"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rank_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/ui2_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
