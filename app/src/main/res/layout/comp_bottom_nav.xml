<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comp_bottom_nav_root"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:background="@drawable/ui2_panel_glass"
    android:orientation="horizontal"
    android:weightSum="2">

    <LinearLayout
        android:id="@+id/nav_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_home_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_nav_rocket"
            android:tint="@color/ui2_body" />

        <TextView
            android:id="@+id/nav_home_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_home"
            android:textColor="@color/ui2_body"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/nav_ranking"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nav_ranking_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_trophy"
            android:tint="@color/ui2_body" />

        <TextView
            android:id="@+id/nav_ranking_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/nav_ranking"
            android:textColor="@color/ui2_body"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
