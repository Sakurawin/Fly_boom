<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#334FC3FF" />
            <stroke android:width="1dp" android:color="#9ED9FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#223F6E93" />
            <stroke android:width="1dp" android:color="#6BAED6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1A28425B" />
            <stroke android:width="1dp" android:color="#446999" />
        </shape>
    </item>
</selector>
